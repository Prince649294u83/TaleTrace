# TaleTrace configuration — copy to .env and fill in your own values.
# .env is gitignored; never commit real keys.

# ---- API keys ----
GOOGLE_VISION_API_KEY=
GROQ_API_KEY=

# ---- Optional model overrides ----
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---- Device endpoints ----
# ESP32 DevKit button server (esp32/esp32.ino serves on port 8080)
ESP32_BUTTONS_URL=http://192.168.1.26:8080/buttons
# ESP32-CAM single-frame capture endpoint (espcam/Almost_final.ino serves on port 80)
ESP32_CAM_CAPTURE_URL=http://192.168.1.200/capture
