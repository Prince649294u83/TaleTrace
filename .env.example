APP_NAME=TaleTrace API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# OCR — two providers, one active at a time
# OCR.Space Engine 2 is the current prototype provider (free tier: 500 req/day,
# 25k req/month, 1 MB/image).  If set, this is used first.
OCR_SPACE_API_KEY=""

# Google Cloud Vision — the original production OCR engine.  Used as a fallback
# when OCR_SPACE_API_KEY is absent, or as the primary when it is the only key set.
GOOGLE_VISION_API_KEY=""

# Groq — two keys, one per subsystem
# They are separate because they fail differently. The Merge Engine calls Groq
# several times a second while the camera runs; the AI Engine calls it once per
# reader request. On a shared key the camera loop exhausts the rate limit and the
# reader is the one who sees the error, so each subsystem builds its own client
# from its own key and neither can take the other down.
#
# AI Engine only: Meaning Mode, contextual explanations, question answering,
# session review, future tutoring. Absent, Meaning Mode cannot explain a word.
GROQ_API_KEY_1=""
# Merge Engine only: dynamic memory reconstruction, OCR text cleanup, text
# reconstruction, same-page semantic comparison. Absent, the system still reads:
# page text falls back to raw OCR and page turns use geometry alone.
GROQ_API_KEY_2=""
# Learning Engine only: generates quizzes and flashcards at the end of a reading
# session based on the reader's performance and encountered concepts.
GROQ_API_KEY_3=""

# Ambient Audio (Freesound)
# Used by the AmbientAssetCache to dynamically download curated CC0 audio for 
# scene moods that don't have a permanent local file in assets/audio/.
# If absent, the system falls back to existing cache files or silence.
FREESOUND_API_KEY=""
# Legacy single key. Read only where the pair above is unset, so an older .env
# keeps working — set the two above instead on anything new.
GROQ_API_KEY=""
# Both engines' model. Set here only to pin one deliberately: the code carries a
# working default, and a name copied from an example outlives the model it names —
# Groq has already retired `llama-3.3-70b-versatile`, and a stale value here would
# override the working default and 404 every call.
GROQ_MODEL=openai/gpt-oss-120b
# The same-page check runs on every frame that looks like a page turn, so it uses
# the fast model rather than the one above.
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Device endpoints (ESP32 rig)
# Only the device loop reads these. Left empty, the sources report themselves as
# unconfigured and the runtime still starts — which is what lets the suite and the
# demos run with no hardware on the desk.
# ESP32 DevKit button server (buttons_and_oled.ino serves on port 8080)
# Example: http://192.168.1.26:8080/buttons
ESP32_BUTTONS_URL=""
# ESP32 DevKit display server (buttons_and_oled.ino serves on port 8080)
# Example: http://192.168.1.26:8080/display
ESP32_DISPLAY_URL=""
# ESP32-CAM single-frame capture endpoint (serves on port 80)
# Example: http://192.168.1.200/capture
ESP32_CAM_CAPTURE_URL=""

# Reading Audio Engine
# AUDIO_PROVIDER: "edge" (default, neural voices, needs network) or
# "offline" (pyttsx3, uses the OS voices, no network). "fake" is for tests.
AUDIO_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural
