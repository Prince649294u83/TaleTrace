# ...except the project's own database, which is committed on purpose. This is a
# group project and the reading history in it is the seeded demo corpus, not
# anybody's private reading: `scripts/seed_history.py` writes it, and having the
# same twelve sessions on every clone is what makes the Analysis page show the
# same charts for everyone without a rig.
#
# It is a binary, so git cannot merge two people's changes to it — a conflict on
# this file is resolved by taking one side and re-running
# `python scripts/seed_history.py --reset`, never by hand.
!/taletrace.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db

# The standalone Gesture tree is its own git repository with its own remote.
# Staging it here records a gitlink, which clones as an empty directory for
# everyone else. Its logic already lives in backend/app/modules/{ocr,gesture_engine}.
backend/app/OCRandGESTURE/Gesture/

# Cached Google Vision responses, keyed by the hash of the preprocessed bytes.
# Derived data: whoever has the photograph can regenerate it for one API call,
# and the entries are large, per-machine, and invalidated by any change to
# `_enhance`. Committing them would also put page text from someone's book in
# the history.
.taletrace_cache/
.gstack/

# Knowledge-graph output from the graphify tool. Derived from the source that is
# already in this repo, and not portable: `.graphify_ast.json` alone is 5MB of
# generated AST, and `.graphify_python` records an absolute path to one machine's
# interpreter, which is wrong for everybody else who clones this.
graphify-out/

# Dynamic Freesound downloads (not permanent assets)
runtime_audio_cache/
scratch/
recordings/
